{
    auto_https off
    admin off
}

https://107.174.53.6:8443 {
    tls /etc/letsencrypt/live/kiro-rs-ip/fullchain.pem /etc/letsencrypt/live/kiro-rs-ip/privkey.pem

    @api path /v1/models /v1/messages /v1/messages/count_tokens /cc/v1/messages /cc/v1/messages/count_tokens
    handle @api {
        reverse_proxy 127.0.0.1:8993 {
            flush_interval -1
        }
    }

    handle {
        respond 404
    }
}
